PORT=8000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ebook_db

# JWT
JWT_SECRET=changez-moi-en-production-avec-une-cle-secrete-longue
JWT_EXPIRES_IN=7d

# Admin par défaut (créé automatiquement au démarrage si absent)
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=changez-ce-mot-de-passe-fort
ADMIN_NAME=Administrateur
# Mettre à true une fois pour réinitialiser le mot de passe admin, puis remettre false
ADMIN_SYNC_PASSWORD=false

# URL publique de l'API Railway (ex: https://votre-api.up.railway.app)
APP_URL=https://votre-api.up.railway.app

# CORS : URL du frontend Railway (séparées par des virgules)
CORS_ORIGINS=https://votre-front.up.railway.app
