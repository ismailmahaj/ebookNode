PORT=8000
NODE_ENV=development

DATABASE_URL=postgresql://ismailmahaj@localhost:5432/ebook_db

JWT_SECRET=changez-moi-en-production-avec-une-cle-secrete-longue
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminExample2024!
ADMIN_NAME=Administrateur
ADMIN_SYNC_PASSWORD=false
ADMIN_SETUP_SECRET=SetupSecret2024!

APP_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 (bucket privé ebooks-storage)
# En local: laisser vide = stockage disque. En prod: R2_REQUIRED=true
R2_REQUIRED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ebooks-storage
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRATION_SECONDS=300
R2_MAX_PDF_SIZE_MB=100
R2_MAX_EPUB_SIZE_MB=100
R2_MAX_COVER_SIZE_MB=10
R2_MAX_AUDIO_SIZE_MB=500

# Production Railway — voir api/railway.env et docs/CLOUDFLARE_R2_SETUP.md
