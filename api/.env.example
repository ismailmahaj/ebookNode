PORT=8000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ebook_db

# JWT
JWT_SECRET=changez-moi-en-production-avec-une-cle-secrete-longue
JWT_EXPIRES_IN=7d

# Admin par défaut (créé au seed si absent)
ADMIN_EMAIL=admin@ebook.local
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Administrateur

# URL publique de l'API (pour les URLs des fichiers uploadés)
APP_URL=http://localhost:8000

# CORS (origines frontend séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
